{
  "manifest_version": 3,
  "name": "PubG",
  "version": "1.3",
  "description": "IRCTC cookies capture and automation extension",

  "permissions": [
    "cookies",
    "webRequest"
  ],

  "host_permissions": [
    "*://*.irctc.co.in/*",
    "*://wps.irctc.co.in/*",
    "http://127.0.0.1:8080/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "IRCTC Cookie Grabber"
  }
}